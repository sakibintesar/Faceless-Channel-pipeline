# ═══ API KEYS — never commit .env (git-ignored) ═══
# Fill in the ones you need; empty keys → that stage degrades to an
# honestly-labeled fallback instead of crashing.

# ── Stock footage (instant keys, free) ──────────────────────────────────────
# https://www.pexels.com/api/   → PEXELS_API_KEY=...
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ → PIXABAY_API_KEY=...
PIXABAY_API_KEY=

# ── Amazon Associates (affiliate — the week-one earner) ─────────────────────
# https://affiliate-program.amazon.com/  (W-8BEN for Bangladesh tax info)
# Associate Tag looks like: yourname-20
AMAZON_ASSOCIATE_TAG=
# PAAPI keys (optional — access granted after 3 qualifying sales/180 days):
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_MARKETPLACE=www.amazon.com

# ── LLM endpoint (optional — real script generation) ────────────────────────
# Any OpenAI-compatible endpoint: OpenRouter, Ollama, vLLM, OpenAI...
# Empty → template_script() stub is used (clearly labeled in output).
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ── YouTube Data API v3 (upload stage) ──────────────────────────────────────
# console.cloud.google.com → enable YouTube Data API v3 → OAuth 2.0 credentials
# → download client_secret.json next to this file (or set path below)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# ── Meta (Facebook Page + Instagram Graph — official APIs) ──────────────────
# developers.facebook.com → create app → generate access token
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ID=
META_PAGE_ID=
